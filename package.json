{
  "name": "pr-crisis-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PRISM — 위기 상황 한 줄이나 기사 URL을 넣으면 골든타임 체크리스트·입장문 2종·기자 답변·유관기관 대응·악화 시나리오를 한 화면에 만들어 주는 위기 대응 패키지 생성기",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bundle:api": "esbuild api/analyze.ts --bundle --format=esm --platform=node --target=node20 --outfile=.tmp/analyze.mjs",
    "verify:package": "python3 scripts/verify_package.py"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
