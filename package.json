{
  "name": "pr-crisis-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PRISM — PR 위기관리·여론 시뮬레이터. 실시간 AI(Vercel /api/analyze, gpt-4o-mini)와 업종 매뉴얼 엔진으로 초안을 수정 2버전·채널 반응·기자 답변·골든타임까지 점검하는 PR 인텔리전스 콘솔",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bundle:api": "esbuild api/analyze.ts --bundle --format=esm --platform=node --target=node20 --outfile=.tmp/analyze.mjs",
    "verify:ai": "python3 scripts/verify_ai.py"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
